@{
    ViewData["Title"] = "Layanan";
}

<style>
    .banner {}

    /* Layanan Section */
    .services {
        text-align: center;
        padding: 40px 0;
    }

    .service-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        justify-content: center;
        padding: 0 5%;
    }

    .service-item {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        padding: 15px;
        text-align: center;
    }

    .service-item img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 10px;
    }

    .services h2 {
        font-size: 32px;
        margin-bottom: 20px;
    }

    .service-item h3 {
        font-size: 18px;
        margin: 10px 0;
        padding: 10px;
    }



    .services h2 {
        font-size: 32px;
        margin-top: 100px;
    }

    .service-item p {
        font-size: 14px;
        color: #666;
    }

    .nav-img {
        max-width: 100%;
    }
</style>



<section class="section">
    <div class=" container" data-aos="fade-up">
        <div class="services">
            <h2>Layanan</h2>
            <div class="service-grid">
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 1">
                    <h3>Analisa Hidrologi dan Hidroklimatologi</h3>
                    <p>Studi terkait curah hujan, debit air, dan siklus hidrologi.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 2">
                    <h3>Analisa Banjir</h3>
                    <p>Pemetaan dan mitigasi daerah rawan banjir.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 3">
                    <h3>Perencanaan Flood Early Warning System</h3>
                    <p>Penyusunan sistem peringatan dini terhadap banjir.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 4">
                    <h3>Perencanaan Bangunan Air (Bendung, Embung, Bendungan, Irigasi)</h3>
                    <p>Desain dan perencanaan infrastruktur sumber daya air.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 5">
                    <h3>Perencanaan Dokumen Kelengkapan SIPPA/Rekomtek</h3>
                    <p>Penyusunan dokumen teknis untuk perizinan sumber daya air.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 6">
                    <h3>Penyusunan Manual OP</h3>
                    <p>Panduan operasional dan pemeliharaan infrastruktur.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 7">
                    <h3>Penyusunan Dokumen AKNOP</h3>
                    <p>Dokumen analisis kebutuhan operasi dan pemeliharaan.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 8">
                    <h3>Penyusunan Kajian Biaya Jasa Pengelolaan Sumber Daya Air</h3>
                    <p>Analisis biaya dalam pengelolaan sumber daya air.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 9">
                    <h3>Penyusunan Dokumen Lingkungan</h3>
                    <p>Dokumen kajian lingkungan untuk proyek infrastruktur.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 10">
                    <h3>Penyusunan LARAP</h3>
                    <p>Dokumen rencana aksi pemukiman kembali.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 11">
                    <h3>Penyusunan Manual OP</h3>
                    <p>Panduan operasional dan pemeliharaan infrastruktur.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 12">
                    <h3>Penyusunan Dokumen AKNOP</h3>
                    <p>Dokumen analisis kebutuhan operasi dan pemeliharaan.</p>
                </div>
                <div class="service-item">
                    <img src="~/assets/img/alt-services.jpg" alt="Service 13">
                    <h3>Training Development</h3>
                    <p>Pelatihan dan pengembangan keterampilan teknis.</p>
                </div>
            </div>
        </div>
    </div>
</section>
