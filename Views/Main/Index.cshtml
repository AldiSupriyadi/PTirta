    <div class="container">
        <h2 class="text-center">Portofolio</h2>
        <div class="row">
            <div class="col-md-6 d-flex align-items-center">
                <img src="~/assets/img/hero-carousel/hero-carousel-1.jpg" class="img-fluid rounded" alt="Project Image">
            </div>
            <div class="col-md-6">
                <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Quidem quisquam excepturi, fuga facere
                    autem,
                    ex consequuntur accusamus officia aliquid maiores hic nisi soluta asperiores cumque dolores.
                    Accusamus
                    laudantium tempora ipsam?</p>
            </div>
        </div>

        <div class="row flex-md-row-reverse">
            <div class="col-md-6 d-flex align-items-center">
                <img src="~/assets/img/hero-carousel/hero-carousel-2.jpg" class="img-fluid rounded" alt="Project Image">
            </div>
            <div class="col-md-6">
                <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Quidem quisquam excepturi, fuga facere
                    autem,
                    ex consequuntur accusamus officia aliquid maiores hic nisi soluta asperiores cumque dolores.
