<section class="section">

    <body>
        <div class="container">
            <!-- Banner besar di atas -->
            <div class="banner"></div>

            <!-- Judul Section -->
            <div class="text-center">
                <h2>Article</h2>
            </div>

            <!-- Grid untuk artikel -->
            <div class="row">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card article-card">
                            <div class="article-image"></div>
                            <div class="card-body">
                                <h5 class="card-title">Judul Article</h5>
                                <p class="card-text">Tanggal</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="more-btn">
            <button onclick="window.location.href='/Article'">More Service</button>
        </div>
        </div>
    </body>
</section>