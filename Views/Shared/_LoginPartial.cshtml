@using Microsoft.AspNetCore.Identity;
@inject SignInManager<Users> signInManager;

<ul class="navbar-nav ms-auto">
	@if (signInManager.IsSignedIn(User))

	{
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Auth" asp-action="Logout">Logout</a>
		</li>
	}

	else
	{

		<li>
			<a asp-area="" asp-controller="Service" asp-action="Index">Service</a>
		</li>
		<li>
			<a asp-area="" asp-controller="Portofolio" asp-action="Index">Portofolio</a>
		</li>
		<li class="nav-item">
			@* <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register"> Register</a> *@
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Auth" asp-action="Login"> Login</a>
		</li>
	}
</ul>